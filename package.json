{
	"name": "pi-fast-explorer",
	"version": "0.1.0",
	"description": "Parallel read-only subagent exploration for the pi coding agent",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
	"files": ["dist", "prompts", "README.md", "LICENSE"],
	"pi": { "extensions": ["dist/index.js"] },
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest --run",
		"typecheck:tests": "tsc -p tsconfig.test.json",
		"bench": "node --experimental-strip-types bench/run.ts"
	},
	"peerDependencies": { "@earendil-works/pi-coding-agent": ">=0.85.0" },
	"dependencies": { "typebox": "1.3.7" },
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": { "node": ">=22.19.0" },
	"license": "MIT",
	"keywords": ["pi", "coding-agent", "extension", "subagent", "context"]
}
